# Google Maps Distance Matrix API key
GOOGLE_MAPS_API_KEY=

# Fixed locations, as "lat,lng"
HOME_COORDS=37.7749,-122.4194
WORK_COORDS=37.3382,-121.8863

# SQLAlchemy-compatible connection string.
#   Postgres: postgresql+psycopg://user:pass@host:5432/dbname
#   SQLite:   sqlite:///./eta.db
DATABASE_URL=sqlite:///./eta.db

# IANA timezone used to derive local hour/minute/day_of_week from each
# UTC reading. This should be the timezone of the commute itself.
LOCAL_TIMEZONE=America/Los_Angeles

# Collector cadence and active window (local time, 24h clock)
COLLECTION_INTERVAL_MINUTES=15
COLLECTION_WINDOW_START_HOUR=6
COLLECTION_WINDOW_END_HOUR=20

# Regression engine default polynomial degree (overridable per run via --degree)
POLY_DEGREE=6
